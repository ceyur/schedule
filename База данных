--Создание функций
-- drop function if exists pairsDayGroup(date, text);
create or replace function pairsDayGroup(
	select_date date,
	select_group text
)
returns table (
	date date,
	number int8,
	time_start text,
	time_end text,
	group_name text,
	subject text,
	teacher text,
	room text
)
language sql
stable
as $$
	select
		sch.date,
		p.id,
		p.time_start,
		p.time_end,
		g.group_name,
		s.subject,
		t.teacher,
		r.room
	from schedule sch

	join pairs p on sch.pair_id = p.id
	join groups g on sch.group_id = g.id 
	join subjects s on sch.subject_id = s.id 
	join teachers t on sch.teacher_id = t.id
	join rooms r on sch.room_id = r.id 
	
	where sch.date = select_date
		and g.group_name = select_group
	order by p.id;
$$;

