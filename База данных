-- Создание таблиц
CREATE TABLE public.pairs (
	id BIGINT GENERATED ALWAYS AS IDENTITY NOT NULL,
	time_start TEXT NOT NULL UNIQUE,
	time_end TEXT NOT NULL UNIQUE,
	CONSTRAINT pairs_pkey PRIMARY KEY (id)
);
CREATE TABLE public.subjects (
	id BIGINT GENERATED ALWAYS AS IDENTITY NOT NULL,
	subject TEXT NOT NULL UNIQUE,
	CONSTRAINT subjects_pkey PRIMARY KEY (id)
);
CREATE TABLE public.groups (
	id BIGINT GENERATED ALWAYS AS IDENTITY NOT NULL,
	group_name TEXT NOT NULL UNIQUE,
	CONSTRAINT groups_pkey PRIMARY KEY (id)
);
CREATE TABLE public.teachers (
	id BIGINT GENERATED ALWAYS AS IDENTITY NOT NULL,
	teacher TEXT NOT NULL,
	CONSTRAINT teachers_pkey PRIMARY KEY (id)
);
CREATE TABLE public.rooms (
	id BIGINT GENERATED ALWAYS AS IDENTITY NOT NULL,
	room TEXT NOT NULL UNIQUE,
	CONSTRAINT rooms_pkey PRIMARY KEY (id)
);
CREATE TABLE public.schedule (
	id BIGINT GENERATED ALWAYS AS IDENTITY NOT NULL,
	date DATE NOT NULL,
	pair_id BIGINT NOT NULL,
	subject_id BIGINT NOT NULL,
	group_id BIGINT NOT NULL,
	teacher_id BIGINT NOT NULL,
	room_id BIGINT NOT NULL,
	CONSTRAINT schedule_pkey PRIMARY KEY (id),
	CONSTRAINT schedule_unique_slot UNIQUE (date, pair_id, group_id),
	CONSTRAINT schedule_pair_id_fkey FOREIGN KEY (pair_id) REFERENCES public.pairs(id),
	CONSTRAINT schedule_subject_id_fkey FOREIGN KEY (subject_id) REFERENCES public.subjects(id),
	CONSTRAINT schedule_group_id_fkey FOREIGN KEY (group_id) REFERENCES public.groups(id),
	CONSTRAINT schedule_teacher_id_fkey FOREIGN KEY (teacher_id) REFERENCES public.teachers(id),
	CONSTRAINT schedule_room_id_fkey FOREIGN KEY (room_id) REFERENCES public.rooms(id)
);
CREATE TABLE public.profiles (
	id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
	name TEXT NOT NULL,
	phone TEXT UNIQUE,
	birth_date DATE,
	created_date TIMESTAMPTZ NOT NULL DEFAULT now(),
	avatar_url TEXT
);

