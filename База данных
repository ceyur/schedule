-- Создание функций
-- DROP FUNCTION IF EXISTS pairsDayGroup(DATE, TEXT);
CREATE OR REPLACE FUNCTION public.pairsDayGroup(
	select_date DATE,
	select_group TEXT
)
RETURNS TABLE (
	date DATE,
	number INT8,
	time_start TEXT,
	time_end TEXT,
	group_name TEXT,
	subject TEXT,
	teacher TEXT,
	room TEXT
)
LANGUAGE SQL
STABLE
AS $$
	SELECT
		sch.date,
		p.id,
		p.time_start,
		p.time_end,
		g.group_name,
		s.subject,
		t.teacher,
		r.room
	FROM public.schedule sch

	JOIN public.pairs p ON sch.pair_id = p.id
	JOIN public.groups g ON sch.group_id = g.id 
	JOIN public.subjects s ON sch.subject_id = s.id 
	JOIN public.teachers t ON sch.teacher_id = t.id
	JOIN public.rooms r ON sch.room_id = r.id 
	
	WHERE sch.date = select_date
		AND g.group_name = select_group
	ORDER BY p.id;
$$;

